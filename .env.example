# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public site URL used for canonical metadata, sitemap and robots.txt.
# Set this to the stable production domain (not a preview deployment URL).
NEXT_PUBLIC_SITE_URL=

# Danchrista Assistant AI
# Keep this server-side. NEVER prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Optional. Defaults to gpt-5.6-luna when omitted.
OPENAI_MODEL=gpt-5.6-luna

# WhatsApp Business Cloud API
# Server-side only. NEVER use NEXT_PUBLIC_ for these values.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Example: v23.0. Keep this aligned with the Meta Graph API version used by your app.
WHATSAPP_GRAPH_VERSION=

# Required for proactive owner alerts when the owner's 24-hour WhatsApp
# customer-service window is closed. Create and get approval for a utility
# template in Meta WhatsApp Manager. The template should contain ONE body
# variable ({{1}}) so Danchrista can place the complete alert inside it.
WHATSAPP_OWNER_TEMPLATE_NAME=
WHATSAPP_OWNER_TEMPLATE_LANGUAGE=en_US
